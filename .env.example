# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false
LOG_LEVEL=INFO

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration
# Main processing model (for complex creativity tasks)
MAIN_MODEL=openai/gpt-5.2
# Fast model (for quick processing, embeddings, small tasks)
FAST_MODEL=openai/gpt-5-nano
# Temperature and generation parameters
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=creativity_engine
POSTGRES_USER=creativity_user
POSTGRES_PASSWORD=change_this_password

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=creativity-engine

# Redis Configuration (for queue and caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ Configuration (for task queue)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=creativity
RABBITMQ_PASSWORD=change_this_password
RABBITMQ_VHOST=/

# Processing Configuration
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=600
ENABLE_SIMPLE_OUTPUT=true

# Memory System Configuration
MEMORY_ACTIVATION_THRESHOLD=0.7
MEMORY_DECAY_RATE=0.95
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# Critique Network Configuration
CRITIQUE_ENSEMBLE_THRESHOLD=0.6
ENABLE_ITERATIVE_REFINEMENT=true
MAX_REFINEMENT_ITERATIONS=3

# Feedback & Learning Configuration
ENABLE_RL_TRAINING=true
TRAINING_BATCH_SIZE=32
LEARNING_RATE=0.001

# Monitoring & Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=
